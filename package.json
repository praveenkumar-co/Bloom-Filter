{
  "name": "scalable-bloom-kit",
  "version": "1.0.2",
  "description": "A TypeScript RedisBloom toolkit for scalable Bloom filters in Node.js.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "benchmark:missing": "npm run build && node examples/benchmark-missing-db.mjs",
    "example:all-methods": "npm run build && node examples/all-methods.mjs",
    "check:redis": "npm run build && node examples/check-real-redis.mjs",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "keywords": [
    "bloom-filter",
    "redis",
    "redisbloom",
    "scalable-bloom-filter",
    "cache",
    "deduplication",
    "probabilistic-data-structures"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "redis": ">=4.6.0 <6"
  },
  "peerDependenciesMeta": {
    "redis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "redis": "^5.12.1",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^2.0.0"
  }
}
